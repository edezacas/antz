test_command=for t in tests/*_test.sh; do sh "$t" || exit 1; done
id=e2e-01 result=skip reason=SKIP stub "e2e-01: a fresh ./install.sh --all renders both clients' antz-orchestrator with the three scripts byte-identical at their fences under the unchanged antz:generated version=4.3.0 marker, the extracted flow script's discover prints the same machine lines as the direct source run, and nothing is installed beyond the pre-change set" in tests/renderinject_test.sh -- e2e-only: live install semantics, run by the verifier (07-e2e.feature)
id=e2e-02 result=skip reason=SKIP stub "e2e-02: the three script suites pass reading scripts/orchestration/ files directly, in-repo discover prints the same candidate= lines as the temp-file invocation, and sh -n passes for each of the three files" in tests/antz-flow_test.sh -- e2e-only: the suite run itself is the verifier's step (a suite cannot run its siblings from inside itself), run by the verifier (07-e2e.feature)
id=e2e-03 result=skip reason=SKIP stub "e2e-03: a live /antz flow's coder sessions write NN-<feature>.result receipts that the orchestrator classifies from disk without running the unit suite, and every report's closing block mirrors its receipt" in tests/receipts_test.sh -- e2e-only: observable only in live /antz sessions (coder receipts + orchestrator classification), run by the verifier (07-e2e.feature)
id=e2e-04 result=skip reason=SKIP stub "e2e-04: in a live flow a BLOCKED: planning refusal stops the session for good with no further delegation, and a twice-rejected change appends two '## Rejection <n>' entries and is never retried again" in tests/orchestrator-sessionguards_test.sh -- e2e-only: observable only in live /antz sessions, run by the verifier (07-e2e.feature)
id=e2e-05 result=skip reason=SKIP stub "e2e-05: against pre-change 4.2.1 installed copies, --check reports the drift to 4.3.0 for both clients and prints the [4.3.0] entry, --all restamps every installed file, and a fresh --check reports already up to date (antz 4.3.0)" in tests/closingblock_test.sh -- e2e-only: live install / drift-report semantics, run by the verifier (07-e2e.feature)
