test_command=sh tests/antz-flow_test.sh && sh tests/renderinject_test.sh
id=ensure-15 result=green reason=test_ensure_15_empty/test_ensure_15_uppercase/test_ensure_15_underscore/test_ensure_15_dot/test_ensure_15_slash/test_ensure_15_leading_hy/test_ensure_15_trailing_hy/test_ensure_15_double_hy/test_ensure_15_len41 (one test per example-table row, reported names "ensure-15 <row>: ensure rejects with state=bad_slug and changes nothing")
id=ensure-16 result=green reason="ensure-16: a 40-character slug is valid (state=created, positioned)" test_ensure_16_len40_slug_is_valid
id=ensure-02 result=green reason="ensure-02: a dirty tree at a new flow's start is refused state=tree_dirty, nothing created or moved" test_ensure_02_new_flow_dirty_tree_refused (rewritten to the new contract)
id=ensure-17 result=green reason="ensure-17: an untracked non-ignored file blocks a new flow with state=tree_dirty" test_ensure_17_untracked_file_blocks_new_flow
id=ensure-05 result=green reason="ensure-05: a refused switch on the resume path stops clean, guard skipped (change dir present)" test_ensure_05_refused_switch_on_resume_stops_clean (rewritten: refusal now lives on the resume path)
id=ensure-18 result=green reason="ensure-18: a dirty change-dir resume positions and appends the advisory dirty=yes" test_ensure_18_change_dir_resume + "ensure-18: a dirty branch-only reuse (no change dir) positions and appends dirty=yes" test_ensure_18_branch_only_reuse + "ensure-18: a dirty change-dir resume with no marker branch is a resume, not a guarded new flow" test_ensure_18_change_dir_no_branch
id=ensure-19 result=green reason="ensure-19: flow-09's scripts byte-unchanged guard is re-scoped to probe+skills, antz-flow.sh edits don't fail it" test_ensure_19_scripts_guard_rescoped (flow-09 itself keeps its reported name and stays green with antz-flow.sh edited)
id=ensure-20 result=green reason="ensure-20: the scripts_distinct helper detects edited/extra/missing injected scripts against fixture trees" ensure_20_helper_on_fixtures + "ensure-20: the base-render identity gate retires (with a note) when an injected script differs, never double-failing with prose drift" ensure_20_gate_decision (tests/renderinject_test.sh)
