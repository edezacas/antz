test_command=for t in tests/*_test.sh; do sh "$t" || exit 1; done
id=marker-01 result=green reason=unit test "marker-01: a destination with the marker as a line-start header comment stays antz-managed: overwritten in place, no backup" in tests/header-marker_test.sh passes (a header-marker destination with version=1.2.3 is overwritten in place with the fresh render under the anchored grep -q "^# $MARKER " detection, no .bak.* file created)
id=marker-02 result=green reason=unit test "marker-02: a file mentioning antz:generated only mid-body is NOT managed: backed up to <destination>.bak.<timestamp> byte-for-byte, then overwritten, stated on the console" in tests/header-marker_test.sh passes (mid-line/indented marker mentions no longer count as managed: exactly one backup named <destination>.bak.<YYYYMMDDHHMMSS> holds the original byte-for-byte, the destination is then overwritten with the managed render, and the console says "not antz-managed")
id=marker-03 result=green reason=unit test "marker-03: installed_version_of reads only the line-start header marker -- a body-mentioned version=9.9.9 reports a fresh install in --check, a real header marker still reports its version" in tests/header-marker_test.sh passes (the anchored sed -n "s/^# $MARKER version=\([^ ]*\).*/\1/p" read makes --check report "fresh install of antz 4.6.0" for a body-mention-only file, while a file with the line-start header marker still reports its embedded 1.2.3)
id=marker-04 result=green reason=unit test "marker-04: backups are created exactly on unmanaged overwrites; accumulated .bak.<ts> files are never pruned, renamed, or rewritten; managed re-runs create none" in tests/header-marker_test.sh passes (two pre-existing .bak.20260101010101/.bak.20260202020202 survive two managed re-runs byte-for-byte under their original names with no new backup; a run overwriting an unmanaged destination creates exactly one new .bak.<14-digit-timestamp> backup of the overwritten content)
id=marker-05 result=green reason=unit test "marker-05: install.sh's header comment states the .bak.<timestamp> policy -- never pruned automatically, cleanup is the user's" in tests/header-marker_test.sh passes (install.sh's header comment now states the backup policy: unmanaged files are backed up to "<file>.bak.<timestamp>" before being overwritten, install.sh never reads/renames/deletes or prunes them automatically, and cleanup is the user's job)
id=marker-06 result=green reason=unit test "marker-06: install.sh's header comment names all four agents (including antz-orchestrator) and both commands (/antz, /antz-set-model)" in tests/header-marker_test.sh passes (the completed opening sentence names antz-specifier, antz-coder, antz-verifier, and antz-orchestrator, plus the /antz and /antz-set-model commands)
