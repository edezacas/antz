test_command=for t in tests/*_test.sh; do sh "$t" || exit 1; done
id=refpin-01 result=green reason=unit test "refpin-01: with no ref signal every fetch URL carries /master/, the install completes from the served tree, and empty ANTZ_REF is byte-for-byte the unset default" in tests/refpin_test.sh passes (remote install.sh run against a recording curl stand-in serving a per-ref fixture tree: with ANTZ_REF unset, and again with it empty, every logged URL matches "<raw-root>/master/<relative-path>" covering VERSION, CHANGELOG.md, all four agents/meta + agents/prompts, and all three scripts/orchestration includes; exit 0, "fresh install of antz 9.9.9" reported from the served tree, installed header marker version=9.9.9; the two runs installed byte-identically and their console reports match modulo the per-run HOME path)
id=refpin-02 result=green reason=unit test "refpin-02: with ANTZ_REF=v4.7.0 every fetched URL carries /v4.7.0/ (VERSION, CHANGELOG.md, agents/meta/specifier.yaml, agents/prompts/orchestrator.prompt, scripts/orchestration/antz-flow.sh among them), none carries /master/, and the markers embed the fetched tree's VERSION" in tests/refpin_test.sh passes (fixture serves a master tree at VERSION 9.9.9 and a v4.7.0 tree at 3.14.1: every logged URL starts "<raw-root>/v4.7.0/", the named rels all appear, no logged URL contains /master/, and the installed agents embed the v4.7.0 tree's version=3.14.1 marker -- the ref is used verbatim and its content actually served)
id=refpin-03 result=green reason=unit test "refpin-03: a checkout install reads every file from disk and never touches the network regardless of ANTZ_REF (failing curl stub never invoked; byte-identical with and without it)" in tests/refpin_test.sh passes (staged checkout with a failing curl stub earlier on PATH: install.sh run with ANTZ_REF=bogus-ref exits 0, VERSION and a staged prompt-prose marker prove the render came from disk, the stub log is empty (never invoked), and the run without ANTZ_REF installs byte-identically -- ANTZ_REF governs only the remote fetch path)
id=refpin-04 result=green reason=unit test "refpin-04: README's install section, install.sh's header usage, and the AGENTS.md/CLAUDE.md RAW_BASE bullets document the tag-pinned ANTZ_REF invocation (shared tagged-URL example, master default, ANTZ_REF override)" in tests/refpin_test.sh passes (README.md's "# Install" section documents fetching install.sh from the tag's raw URL and passing ANTZ_REF=<tag> to sh with the tagged-URL example and the master default; install.sh's header usage comment carries the same example line and the same facts; the exactly-one RAW_BASE bullet in AGENTS.md and CLAUDE.md is byte-identical between them, names ANTZ_REF with the master default, and the stale "currently GitHub master" fixed-source claim is gone)
id=refpin-05 result=green reason=unit test "refpin-05: the fetch architecture is preserved -- injection fetches through fetch_file \"$rel\", exactly one executable curl -fsSL inside fetch_file, and the ref is substituted at the RAW_BASE construction, not per call site" in tests/refpin_test.sh passes (install.sh's executable code still contains fetch_file "$rel", exactly one curl -fsSL outside comments and it sits inside fetch_file reading the whole URL from "$RAW_BASE/$rel", and ANTZ_REF is read exactly once in executable code -- on the RAW_BASE= line itself; renderinject-04_shared_fetch_path and renderinject-06 stay green, unmodified, in the full-suite run)
