test_command=for t in tests/*_test.sh; do sh "$t" || exit 1; done
id=setmodel-01 result=green reason=unit test "setmodel-01: embedded script's managed check is anchored to the line-start header marker (header fixture accepted at the fixed position; mid-body-mention-only fixture refused as not antz-managed, exit non-zero, byte-for-byte unchanged)" in tests/set-model-command_test.sh passes (the emitted script's check is now grep -q "^# $MARKER " — same anchor as install_file; the header-marked fixture gains model: opus at the fixed position with the success reply, a fixture mentioning antz:generated only mid-body or indented is refused with the existing not-antz-managed error, exits non-zero, left byte-for-byte unchanged; red before the anchored grep, which accepted and rewrote the mid-body fixture)
id=setmodel-02 result=green reason=unit test "setmodel-02: no mktemp scratch left in TMPDIR after a successful set, a successful clear, or the nothing-to-clear no-op (each exits 0 with its documented reply)" in tests/set-model-command_test.sh passes (isolated TMPDIR empty after all three runs; set/clear additionally assert the file's post-run content so a trap removing the wrong file cannot pass; the no-op path exits before the mktemp)
id=setmodel-03 result=green reason=unit test "setmodel-03: mid-run rewrite failure (read-only target) exits non-zero, leaves the target byte-for-byte unchanged, and the cleanup trap removes the scratch file" in tests/set-model-command_test.sh passes (trap 'rm -f "$tmp"' EXIT set at scratch creation; red before the trap, which left the scratch in TMPDIR; explicit uid-0 skip path mirrors the posixsh-02 environmental-skip pattern — ran green here as a non-root user)
id=setmodel-04 result=green reason=unit test "setmodel-04: emitted script survives the changes token-free (no dollar-digit, no $ARGUMENTS in either embedded script, POSIX-parseable), each body keeps exactly the one 'Arguments: $ARGUMENTS' injection line" in tests/set-model-command_test.sh passes (extracted scripts from both clients' rendered command bodies scanned for dollar-digit and $ARGUMENTS sequences, sh -n clean, plus bash 3.2 --posix -n verified out-of-band; each command body holds exactly one $ARGUMENTS occurrence, the intended injection line)
